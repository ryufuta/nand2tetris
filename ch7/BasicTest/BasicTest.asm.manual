// push constant 10
  // RAM[++SP -1]=D
@10
D=A
@SP
AM=M+1
A=A-1
M=D

// pop local 0
@SP
AM=M-1
D=M
@LCL
A=M
M=D

// pop argument 2
  // D=RAM[--SP]
  // RAM[ARG+2]=D
  // ryu さんの実装だと14行
@2
D=A
@ARG
D=D+M
@R13
M=D
@SP
AM=M-1
D=M
@R13
A=M // ryu さん追加
M=D

// pop argument 2 (SP の操作を先にやる)
@SP
AM=M-1
D=M
@R13
M=D
@ARG
D=M
@2
D=D+A
@R14
M=D
@R13
D=M
@R14
A=M
M=D

// pop temp 6
  // D=RAM[--SP]
  // RAM[5+6]=D
@SP
AM=M-1
D=M
@R11
M=D

// push local 0
  // D=RAM[LCL]
  // RAM[++SP -1]=D
@LCL
A=M
D=M
@SP
AM=M+1
A=A-1
M=D

// push that 5
  // D=RAM[THAT+5]
  // RAM[++SP -1]=D
@5
D=A
@THAT
A=D+M
D=M
@SP
AM=M+1
A=A-1
M=D

// add
@SP
AM=M-1
D=M
A=A-1
M=D+M

// push temp 6
  // D=RAM[5+6]
  // RAM[++SP -1]=D
@R11
D=M
@SP
AM=M+1
A=A-1
M=D
